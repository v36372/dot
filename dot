#!/usr/bin/env bash
# Minimal dotfiles manager (stow-based), inspired by dmmulroy/.dotfiles
# Falls back to ln -s if GNU Stow is not installed.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export DOTFILES_DIR
TARGET_DIR="${HOME}"
PACKAGE_DIR="$DOTFILES_DIR/home"

resolve_path() {
  local path="$1"

  if command -v realpath >/dev/null 2>&1; then
    realpath "$path" 2>/dev/null
    return
  fi

  # Portable fallback for systems without realpath. Resolve a final symlink
  # recursively; cd -P resolves any symlinks in its parent directory.
  if [[ -L "$path" ]]; then
    local target
    target="$(readlink "$path")"
    if [[ "$target" != /* ]]; then
      target="$(dirname "$path")/$target"
    fi
    resolve_path "$target"
    return
  fi

  local dir base
  dir="$(dirname "$path")"
  base="$(basename "$path")"
  (cd -P "$dir" 2>/dev/null && printf '%s/%s\n' "$PWD" "$base")
}

paths_match() {
  local actual expected
  actual="$(resolve_path "$1")" || return 1
  expected="$(resolve_path "$2")" || return 1
  [[ "$actual" == "$expected" ]]
}

usage() {
  cat <<'EOF'
dot — personal dotfiles helper

Usage:
  dot stow [PART...]    Create/update all or selected symlinks
  dot restow [PART...]  Same as stow
  dot unstow [PART...]  Remove all or selected managed symlinks
  dot components        List selectable config parts
  dot herdr-plugin  Build/link packages/herdr-toggle-popup
  dot add-skill     Vendor one skill from a GitHub skill-dir URL
  dot skills-sync   Update locked third-party skills
  dot doctor        Check tools + symlink health + herdr plugin
  dot path          Print repo path
  dot help          Show this help

Layout:
  home/             Mirrors ~ and is linked into $HOME
  packages/         Optional package lists / notes (herdr-toggle-popup lives here)

Parts:
  agents fish ghostty git herdr mpv nvim pi starship tmux

Examples:
  dot stow fish
  dot stow agents fish
  dot unstow nvim
EOF
}

COMPONENTS=(agents fish ghostty git herdr mpv nvim pi starship tmux)
SELECT_ALL=0
SELECTED_COMPONENTS=()
SELECTED_PATHS=()

component_paths() {
  case "$1" in
    agents) printf '%s\n' .agents ;;
    fish) printf '%s\n' .config/fish ;;
    ghostty) printf '%s\n' .config/ghostty ;;
    git) printf '%s\n' .config/git .gitconfig .gitconfig_personal .gitignore_global ;;
    herdr) printf '%s\n' .config/herdr ;;
    mpv) printf '%s\n' .config/mpv ;;
    nvim) printf '%s\n' .config/nvim ;;
    pi) printf '%s\n' .pi ;;
    starship) printf '%s\n' .config/starship.toml ;;
    tmux) printf '%s\n' .config/tmux ;;
  esac
}

canonical_component() {
  case "$1" in
    agents|agent-skills|skills) echo agents ;;
    fish|ghostty|git|herdr|mpv|nvim|pi|starship|tmux) echo "$1" ;;
    *) return 1 ;;
  esac
}

select_components() {
  local requested=("$@") component canonical path
  SELECT_ALL=0
  SELECTED_COMPONENTS=()
  SELECTED_PATHS=()

  if [[ "${#requested[@]}" -eq 0 ]]; then
    SELECT_ALL=1
    requested=("${COMPONENTS[@]}")
  fi

  for component in "${requested[@]}"; do
    if [[ "$component" == all ]]; then
      SELECT_ALL=1
      requested=("${COMPONENTS[@]}")
      SELECTED_COMPONENTS=()
      SELECTED_PATHS=()
      break
    fi
  done

  for component in "${requested[@]}"; do
    canonical="$(canonical_component "$component")" || {
      echo "unknown part: $component" >&2
      echo "available parts: ${COMPONENTS[*]}" >&2
      return 1
    }

    case " ${SELECTED_COMPONENTS[*]-} " in
      *" $canonical "*) continue ;;
    esac

    SELECTED_COMPONENTS+=("$canonical")
    for path in $(component_paths "$canonical"); do
      SELECTED_PATHS+=("$path")
    done
  done
}

component_selected() {
  local wanted="$1" component
  [[ "$SELECT_ALL" -eq 1 ]] && return 0
  for component in "${SELECTED_COMPONENTS[@]}"; do
    [[ "$component" == "$wanted" ]] && return 0
  done
  return 1
}

path_selected() {
  local rel="$1" root
  [[ "$SELECT_ALL" -eq 1 ]] && return 0
  for root in "${SELECTED_PATHS[@]}"; do
    [[ "$rel" == "$root" || "$rel" == "$root/"* ]] && return 0
  done
  return 1
}

stow_filter_args() {
  local allowed="" path escaped ancestor

  [[ "$SELECT_ALL" -eq 1 ]] && return 0
  for path in "${SELECTED_PATHS[@]}"; do
    escaped="$(printf '%s' "$path" | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
    [[ -n "$allowed" ]] && allowed+="|"
    allowed+="$escaped(?:/.*)?"

    ancestor="$path"
    while [[ "$ancestor" == */* ]]; do
      ancestor="${ancestor%/*}"
      escaped="$(printf '%s' "$ancestor" | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
      allowed+="|$escaped"
    done
  done

  printf '%s\n' "--ignore=^(?!(?:$allowed)\$).*"
}

# Stow folds whole directories into one symlink unless their target directory
# already exists. Keep component roots real so later selective unstows are safe.
prepare_stow_dirs() {
  local root src part current src_current dest_current

  for root in "${SELECTED_PATHS[@]}"; do
    src="$PACKAGE_DIR/$root"
    [[ -d "$src" ]] || continue

    current=""
    src_current="$PACKAGE_DIR"
    dest_current="$TARGET_DIR"
    IFS='/' read -r -a parts <<< "$root"
    for part in "${parts[@]}"; do
      [[ -z "$part" ]] && continue
      current="${current:+$current/}$part"
      src_current="$src_current/$part"
      dest_current="$dest_current/$part"

      if [[ -L "$dest_current" ]] && paths_match "$dest_current" "$src_current"; then
        if [[ "$current" != "$root" && "$SELECT_ALL" -ne 1 ]]; then
          echo "cannot select only ${SELECTED_COMPONENTS[*]} while $current links the full suite" >&2
          echo "run './dot stow' once to unfold the old layout, then retry" >&2
          return 1
        fi
        echo "  unfold $current"
        rm -f "$dest_current"
        mkdir -p "$dest_current"
      elif [[ ! -e "$dest_current" ]]; then
        mkdir -p "$dest_current"
      elif [[ ! -d "$dest_current" ]]; then
        echo "target is not a directory: $dest_current" >&2
        return 1
      fi
    done
  done
}

rel_from_home() {
  # print path relative to PACKAGE_DIR (no leading ./)
  local abs="$1"
  echo "${abs#"$PACKAGE_DIR"/}"
}

link_file() {
  local src="$1"
  local rel
  rel="$(rel_from_home "$src")"
  local dest="$TARGET_DIR/$rel"
  local dest_dir
  dest_dir="$(dirname "$dest")"

  mkdir -p "$dest_dir"

  # A parent directory may itself be a Stow symlink. In that case $dest is a
  # regular file reached through the link, but it already resolves to $src.
  if [[ -e "$dest" || -L "$dest" ]] && paths_match "$dest" "$src"; then
    echo "  keep  $rel"
    return 0
  fi

  if [[ -L "$dest" ]]; then
    echo "  relink $rel"
    rm -f "$dest"
  elif [[ -e "$dest" ]]; then
    local bak="${dest}.bak.$(date +%s)"
    echo "  backup $rel -> $bak"
    mv "$dest" "$bak"
  else
    echo "  link  $rel"
  fi

  ln -s "$src" "$dest"
}

unlink_file() {
  local src="$1"
  local rel
  rel="$(rel_from_home "$src")"
  local dest="$TARGET_DIR/$rel"

  if [[ -L "$dest" ]]; then
    if paths_match "$dest" "$src"; then
      echo "  unlink $rel"
      rm -f "$dest"
    else
      echo "  skip   $rel (points elsewhere)"
    fi
  fi
}

HERDR_TOGGLE_POPUP_DIR="$DOTFILES_DIR/packages/herdr-toggle-popup"
HERDR_TOGGLE_POPUP_BIN="$HERDR_TOGGLE_POPUP_DIR/bin/toggle-popup"
HERDR_TOGGLE_POPUP_CONFIG_SRC="$HERDR_TOGGLE_POPUP_DIR/config/config.toml"
HERDR_TOGGLE_POPUP_CONFIG_DIR="$TARGET_DIR/.config/herdr/plugins/config/local.toggle-popup"
HERDR_TOGGLE_POPUP_CONFIG_DEST="$HERDR_TOGGLE_POPUP_CONFIG_DIR/config.toml"
HERDR_TOGGLE_POPUP_ID="local.toggle-popup"

herdr_toggle_popup_linked() {
  command -v herdr >/dev/null 2>&1 || return 1
  [[ "$(herdr plugin list 2>/dev/null)" == *"$HERDR_TOGGLE_POPUP_ID"* ]]
}

ensure_herdr_toggle_popup_bin() {
  local newer_source

  if [[ -x "$HERDR_TOGGLE_POPUP_BIN" ]]; then
    # Rebuild when any tracked source is newer than the binary.
    newer_source="$(find "$HERDR_TOGGLE_POPUP_DIR" \
      \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' -o -name 'herdr-plugin.toml' \) \
      -newer "$HERDR_TOGGLE_POPUP_BIN" -print -quit 2>/dev/null)"
    if [[ -z "$newer_source" ]]; then
      return 0
    fi
  fi

  if ! command -v go >/dev/null 2>&1; then
    echo "  skip  herdr-toggle-popup build (go not found)"
    return 1
  fi

  echo "  build herdr-toggle-popup"
  mkdir -p "$(dirname "$HERDR_TOGGLE_POPUP_BIN")"
  (
    cd "$HERDR_TOGGLE_POPUP_DIR"
    go build -o bin/toggle-popup .
  )
}

seed_herdr_toggle_popup_config() {
  mkdir -p "$HERDR_TOGGLE_POPUP_CONFIG_DIR"
  if [[ -e "$HERDR_TOGGLE_POPUP_CONFIG_DEST" ]]; then
    echo "  keep  plugins/config/local.toggle-popup/config.toml"
    return 0
  fi
  if [[ ! -f "$HERDR_TOGGLE_POPUP_CONFIG_SRC" ]]; then
    echo "  miss  $HERDR_TOGGLE_POPUP_CONFIG_SRC" >&2
    return 1
  fi
  cp "$HERDR_TOGGLE_POPUP_CONFIG_SRC" "$HERDR_TOGGLE_POPUP_CONFIG_DEST"
  echo "  seed  plugins/config/local.toggle-popup/config.toml"
}

# Build binary, link local plugin, seed runtime config.
# Best-effort when called from stow: missing herdr/go prints a skip, not a hard fail.
cmd_herdr_plugin() {
  local strict="${1:-1}"
  local ok=0

  echo "== herdr-toggle-popup =="

  if [[ ! -d "$HERDR_TOGGLE_POPUP_DIR" ]]; then
    echo "  miss  $HERDR_TOGGLE_POPUP_DIR"
    [[ "$strict" == "1" ]] && return 1
    return 0
  fi

  if ! ensure_herdr_toggle_popup_bin; then
    if [[ ! -x "$HERDR_TOGGLE_POPUP_BIN" ]]; then
      echo "  fail  binary missing: $HERDR_TOGGLE_POPUP_BIN"
      [[ "$strict" == "1" ]] && return 1
      return 0
    fi
  fi

  if ! command -v herdr >/dev/null 2>&1; then
    echo "  skip  herdr plugin link (herdr not found)"
    seed_herdr_toggle_popup_config || true
    [[ "$strict" == "1" ]] && return 1
    return 0
  fi

  if herdr_toggle_popup_linked; then
    # Re-link keeps plugins.json in sync if the package path moved.
    echo "  link  $HERDR_TOGGLE_POPUP_ID (refresh)"
  else
    echo "  link  $HERDR_TOGGLE_POPUP_ID"
  fi
  if ! herdr plugin link "$HERDR_TOGGLE_POPUP_DIR" >/dev/null; then
    echo "  fail  herdr plugin link"
    [[ "$strict" == "1" ]] && return 1
    return 0
  fi

  seed_herdr_toggle_popup_config || ok=1

  if herdr_toggle_popup_linked && [[ -x "$HERDR_TOGGLE_POPUP_BIN" ]]; then
    echo "  ok    ctrl+n -> $HERDR_TOGGLE_POPUP_ID.toggle-shell"
  else
    echo "  warn  plugin not fully installed"
    ok=1
  fi

  [[ "$ok" -eq 0 ]]
}

cmd_stow() {
  select_components "$@"
  prepare_stow_dirs

  if command -v stow >/dev/null 2>&1; then
    local filter_args=()
    while IFS= read -r arg; do
      [[ -n "$arg" ]] && filter_args+=("$arg")
    done < <(stow_filter_args)
    (
      cd "$DOTFILES_DIR"
      if [[ "$SELECT_ALL" -eq 1 ]]; then
        stow --target="$TARGET_DIR" --restow --verbose=1 home
      else
        stow --target="$TARGET_DIR" --restow --verbose=1 "${filter_args[@]}" home
      fi
    )
    echo "stowed via GNU Stow: ${SELECTED_COMPONENTS[*]}"
  else
    echo "GNU Stow not found; using ln -s fallback"
    # Skip runtime junk
    while IFS= read -r -d '' f; do
      path_selected "$(rel_from_home "$f")" || continue
      case "$f" in
        *.log|*.sock) continue ;;
      esac
      link_file "$f"
    done < <(find "$PACKAGE_DIR" -type f -print0)

    echo "linked $PACKAGE_DIR -> $TARGET_DIR"
  fi

  # Non-strict: configs still land even if herdr/go are missing on a fresh box.
  component_selected herdr && cmd_herdr_plugin 0 || true
}

cmd_unstow() {
  select_components "$@"

  if command -v stow >/dev/null 2>&1; then
    local filter_args=()
    while IFS= read -r arg; do
      [[ -n "$arg" ]] && filter_args+=("$arg")
    done < <(stow_filter_args)
    (
      cd "$DOTFILES_DIR"
      if [[ "$SELECT_ALL" -eq 1 ]]; then
        stow --target="$TARGET_DIR" --delete --verbose=1 home
      else
        stow --target="$TARGET_DIR" --delete --verbose=1 "${filter_args[@]}" home
      fi
    )
    echo "unstowed via GNU Stow: ${SELECTED_COMPONENTS[*]}"
    return 0
  fi

  echo "GNU Stow not found; removing managed symlinks"
  while IFS= read -r -d '' f; do
    path_selected "$(rel_from_home "$f")" || continue
    unlink_file "$f"
  done < <(find "$PACKAGE_DIR" -type f -print0)
}

cmd_add_skill() {
  "$PACKAGE_DIR/.agents/skills/scripts/add-skill.sh" "$@"
}

cmd_skills_sync() {
  "$PACKAGE_DIR/.agents/skills/scripts/sync-skills.sh" "$@"
}

cmd_doctor() {
  echo "== tools =="
  for t in nvim tmux fish ghostty herdr stow rg fd fzf starship git go; do
    if command -v "$t" >/dev/null 2>&1; then
      printf "  ok  %s (%s)\n" "$t" "$(command -v "$t")"
    else
      printf "  MISSING  %s\n" "$t"
    fi
  done

  echo
  echo "== key paths =="
  for p in \
    .agents/.skill-lock.json \
    .agents/skills \
    .gitconfig \
    .gitignore_global \
    .config/fish/config.fish \
    .config/nvim/init.lua \
    .config/tmux/tmux.conf \
    .config/ghostty/config \
    .config/herdr/config.toml \
    .config/starship.toml \
    .config/mpv/mpv.conf
  do
    target="$TARGET_DIR/$p"
    expected="$PACKAGE_DIR/$p"
    if [[ -e "$target" ]] && paths_match "$target" "$expected"; then
      printf "  ok    %s\n" "$p"
    elif [[ -L "$target" ]]; then
      printf "  OTHER %s -> %s\n" "$p" "$(readlink "$target")"
    elif [[ -e "$target" ]]; then
      printf "  FILE  %s (exists, not symlink — will be backed up on stow)\n" "$p"
    else
      printf "  miss  %s\n" "$p"
    fi
  done

  echo
  echo "== herdr float plugin =="
  if [[ -x "$HERDR_TOGGLE_POPUP_BIN" ]]; then
    printf "  ok    binary %s\n" "$HERDR_TOGGLE_POPUP_BIN"
  else
    printf "  miss  binary %s (run: ./dot herdr-plugin)\n" "$HERDR_TOGGLE_POPUP_BIN"
  fi

  if [[ -f "$HERDR_TOGGLE_POPUP_CONFIG_DEST" ]]; then
    printf "  ok    config %s\n" "$HERDR_TOGGLE_POPUP_CONFIG_DEST"
  else
    printf "  miss  config %s\n" "$HERDR_TOGGLE_POPUP_CONFIG_DEST"
  fi

  if ! command -v herdr >/dev/null 2>&1; then
    printf "  miss  herdr CLI\n"
  elif herdr_toggle_popup_linked; then
    printf "  ok    linked as %s\n" "$HERDR_TOGGLE_POPUP_ID"
  else
    printf "  miss  not linked (run: ./dot herdr-plugin)\n"
  fi

  if command -v herdr >/dev/null 2>&1 && [[ -f "$TARGET_DIR/.config/herdr/config.toml" ]]; then
    if grep -Fq 'local.toggle-popup.toggle-shell' "$TARGET_DIR/.config/herdr/config.toml"; then
      printf "  ok    keybind ctrl+n -> local.toggle-popup.toggle-shell\n"
    else
      printf "  miss  keybind for local.toggle-popup.toggle-shell in config.toml\n"
    fi
  fi

  echo
  echo "== repo =="
  echo "  $DOTFILES_DIR"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    stow|link|install|restow) cmd_stow "$@" ;;
    unstow|unlink) cmd_unstow "$@" ;;
    herdr-plugin) cmd_herdr_plugin 1 "$@" ;;
    add-skill) cmd_add_skill "$@" ;;
    skills-sync) cmd_skills_sync "$@" ;;
    components) printf '%s\n' "${COMPONENTS[@]}" ;;
    doctor) cmd_doctor "$@" ;;
    path) echo "$DOTFILES_DIR" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
