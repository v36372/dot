[user]
  # Fallback identity for repos outside work/personal includeIf roots.
  # Overridden by ~/.gitconfig_work or ~/.gitconfig_personal via includeIf.
  name = Tin Nguyen
  email = tin.nguyen.work@protonmail.com
  username = v36372
[core]
  editor = nvim
  excludesfile = ~/.gitignore_global
[diff]
  external = difft
[format]
  pretty = format:%h %s (%an, %ad)
[alias]
  # `git log` with patches shown with difftastic.
  dl = -c diff.external=difft log -p --ext-diff

  # Show the most recent commit with difftastic.
  ds = -c diff.external=difft show --ext-diff

  # `git diff` with difftastic.
  dft = -c diff.external=difft diff
  st = status
  d = diff
  b = branch
  p = push
  pr = pull --rebase
  pom = pull origin master
  co = checkout
  l = log --date-order --graph --pretty=format:'%C(green)%h %Creset%C(yellow)%an%Creset %C(blue bold)%ar%Creset %C(red bold)%d%Creset %s'
  precommit = diff --cached --diff-algorithm=minimal -w
  branches = branch -a
  stashes = stash list
  unstage = reset -q HEAD --
  related = "!function git_related() { if git rev-list $1 | grep -q $2 ; then echo \"$2 is ancestor of $1\" ; elif git rev-list $2 | grep -q $1 ; then echo \"$1 is ancestor of $2\" ; else echo \"$1 unrelated to $2\" ; fi  } ; git_related $1 $2"
  hlog = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%Creset' --abbrev-commit
  lg = log --date-order --all --graph --format='%C(green)%h %Creset%C(yellow)%an%Creset %C(blue bold)%ar%Creset %C(red bold)%d%Creset %s'
[color]
  ui = true
[push]
  default = simple
[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22
[color "diff"]
  meta = 11
  frag = magenta bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[init]
  defaultBranch = master

# Work identity for Sky Mavis / security workspace repos.
[includeIf "gitdir:~/codes/sm/"]
  path = ~/.gitconfig_work
[includeIf "gitdir:~/codes/sm/**"]
  path = ~/.gitconfig_work

# Personal identity for personal code roots.
[includeIf "gitdir:~/codes/personal/"]
  path = ~/.gitconfig_personal
[includeIf "gitdir:~/codes/personal/**"]
  path = ~/.gitconfig_personal

# Seamless personal GitHub access without remembering a special remote host.
# Rewrites only v36372/* URLs to the SSH host that uses ~/.ssh/personal.
# Work repos (other owners) keep default github.com → work key.
[url "git@github-v36372:"]
  insteadOf = git@github.com:v36372/
  insteadOf = https://github.com/v36372/
  insteadOf = ssh://git@github.com/v36372/

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
