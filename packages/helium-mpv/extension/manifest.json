{
  "manifest_version": 3,
  "name": "Play Stream in mpv",
  "description": "Detect HLS, DASH, and FLV streams in the current tab and open them in mpv.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Play stream in mpv"
  }
}
